{
  "outputDirectory": "public",
  "functions": {
    "api/cron/sync.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync?modo=completo",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sync?modo=completo&turno=noite",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=0",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=1",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=2",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=3",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=4",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=5",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=6",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=7",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=8",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=10",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=11",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=12",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=13",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=14",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=15",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=16",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=17",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=18",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=19",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=20",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=22",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/sync?modo=retroativo&h=23",
      "schedule": "30 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}

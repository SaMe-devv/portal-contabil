# Na Vercel, cadastre em Settings > Environment Variables. Copie para .env apenas para rodar localmente.

# Banco Postgres (criado em Storage > Neon; a Vercel preenche sozinha)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Texto aleatório com 32+ caracteres (gere em https://generate-secret.vercel.app/48)
SESSION_SECRET=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres

# Chave que criptografa os certificados A1 e os segredos de 2FA. 32+ caracteres, DIFERENTE da anterior.
# Guarde uma cópia em local seguro: se ela for trocada ou perdida, os certificados precisam ser enviados de novo.
ENCRYPTION_KEY=outro-texto-aleatorio-com-pelo-menos-32-caracteres

# Senha do agendador (a Vercel envia sozinha nas chamadas das 6h e 18h). 16+ caracteres.
CRON_SECRET=mais-um-texto-aleatorio

# Primeiro login do escritório (usado só na criação do primeiro ADM)
ADMIN_EMAIL=voce@samecontabilidade.com.br
ADMIN_PASSWORD=defina-uma-senha-forte

# Opcional: 2 = ambiente de homologação da SEFAZ (testes). Padrão: produção.
# SEFAZ_AMBIENTE=2

# Opcional: cadeia ICP-Brasil em PEM, só se o download automático do ITI falhar.
# ICP_BRASIL_CA_PEM=-----BEGIN CERTIFICATE-----...
